# Copy to .env and fill in. `.env` is gitignored.

# Which backend the target agent talks to.
#   openai (default) | azure | stub
# "stub" is an offline keyword router for verifying plumbing / running CI with
# no API key. It cannot be socially engineered, so it produces NO valid
# security findings -- never score a real report from a stub run.
LLM_PROVIDER=openai

# --- OpenAI direct API (default path) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# --- Azure OpenAI (only needed when LLM_PROVIDER=azure) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Target agent behaviour ---
# Stage 6 tool-level guardrails on issue_refund (existence check, amount
# ceiling, CONFIRMED gate). Set to "off" to restore the original vulnerable
# tool -- used by the demo and by the CI job that proves the regression gate
# actually fails when the fix is reverted.
PAYSENTRY_GUARDRAILS=on

# Object-level authorization on the data tools (the LLM02 fix). When a session
# carries an authenticated customer, get_transaction_status and issue_refund
# refuse transactions belonging to anyone else. Set to "off" to restore the
# original unscoped behaviour for the before/after demonstration.
# Kept separate from PAYSENTRY_GUARDRAILS because the two findings have
# different root causes: LLM06 was a missing tool precondition, LLM02 was the
# absence of any identity to check against.
PAYSENTRY_AUTHZ=on

# Port for run_agent.py. The demo runs the patched build on 8000 and the
# vulnerable build on 8001 at the same time, so no restart is needed mid-demo.
PAYSENTRY_PORT=8000

# --- Tooling workarounds (see README "Implementation notes") ---
# promptfoo spawns a Python worker using whatever `python` it finds. If that
# interpreter is broken it dies with "Worker failed to become ready within
# timeout". Point it at a known-good one.
# PROMPTFOO_PYTHON=

# garak 0.9.x hardcodes a 10s HTTP timeout, which is too short for a reasoning
# model and produces false SECURE results. redteam/garak_launcher.py patches
# it; override the value here if needed.
# GARAK_REQUEST_TIMEOUT=180

# --- Vercel deployment only (see README "Deploying to Vercel") ---
# KV_REST_API_URL / KV_REST_API_TOKEN are injected automatically by Vercel when
# a KV store is attached to the project -- never set these by hand, and never
# in a local .env; target_agent/store.py falls back to in-memory storage
# whenever they're absent, which is what every local run should do.
#
# DEBUG_TOKEN gates /debug/reset ONLY (requires a matching X-Debug-Token
# header) -- not /debug/refund_log, which stays open even when this is set
# because the demo UI's live ledger panel reads it unauthenticated for every
# visitor. Unset locally (the red-team suite expects reset open too).
# Recommended on a public deployment so a random visitor can't wipe the
# ledger mid-demo for everyone else looking at the same URL.
# DEBUG_TOKEN=
